@inject NavigationManager Navigation

<nav class="bottom-nav">
    <a href="./" class="nav-item @(IsActive("") ? "active" : "")">
        <i class="bi bi-house-door-fill"></i>
        <span>Início</span>
    </a>
    <a href="extrato" class="nav-item @(IsActive("extrato") ? "active" : "")">
        <i class="bi bi-receipt"></i>
        <span>Extrato</span>
    </a>
    <a href="configuracoes" class="nav-item @(IsActive("configuracoes") ? "active" : "")">
        <i class="bi bi-cloud-arrow-up-fill"></i>
        <span>Sincronização</span>
    </a>
</nav>

@code {
    private bool IsActive(string route)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(route))
        {
            return string.IsNullOrEmpty(relative);
        }
        return relative.StartsWith(route, StringComparison.OrdinalIgnoreCase);
    }
}
