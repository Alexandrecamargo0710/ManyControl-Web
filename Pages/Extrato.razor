@page "/extrato"
@using ManyControl_Web.Models
@using ManyControl_Web.Services
@inject FinanceWebService FinanceService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>ManyControl - Extrato</PageTitle>

<!-- Barra de Navegação de Mês -->
<div class="month-card">
    <div class="month-controls">
        <button class="month-btn-arrow" @onclick="MesAnterior"><i class="bi bi-chevron-left"></i></button>
        <div class="month-text-label">@NomeMesAno</div>
        <button class="month-btn-arrow" @onclick="ProximoMes"><i class="bi bi-chevron-right"></i></button>
    </div>
    @if (IsMesDiferenteDoAtual)
    {
        <button class="btn-current-month" @onclick="VoltarMesAtual">
            Ir para o mês atual
        </button>
    }
</div>

<!-- Cards de Totais do Mês -->
<div class="metrics-grid">
    <div class="metric-card card-receitas">
        <div class="metric-card-header">
            <span class="metric-card-title">Entradas do Mês</span>
            <span class="metric-card-info" @onclick='() => ExplicarMetrica("receitas")'>ⓘ</span>
        </div>
        <div class="metric-card-value">@TotalReceitasMes.ToString("C2", PtBr)</div>
    </div>

    <div class="metric-card card-despesas">
        <div class="metric-card-header">
            <span class="metric-card-title">Saídas do Mês</span>
            <span class="metric-card-info" @onclick='() => ExplicarMetrica("despesas")'>ⓘ</span>
        </div>
        <div class="metric-card-value">@TotalDespesasMes.ToString("C2", PtBr)</div>
    </div>

    <div class="metric-card card-pendentes">
        <div class="metric-card-header">
            <span class="metric-card-title">A Pagar (Pendente)</span>
            <span class="metric-card-info" @onclick='() => ExplicarMetrica("pendentes")'>ⓘ</span>
        </div>
        <div class="metric-card-value">@TotalDespesasPendentesMes.ToString("C2", PtBr)</div>
    </div>

    <div class="metric-card card-pagas">
        <div class="metric-card-header">
            <span class="metric-card-title">Já Pago</span>
            <span class="metric-card-info" @onclick='() => ExplicarMetrica("pagas")'>ⓘ</span>
        </div>
        <div class="metric-card-value">@TotalDespesasPagasMes.ToString("C2", PtBr)</div>
    </div>
</div>

<!-- Card Balanço do Mês -->
<div class="native-card" style="background-color: var(--card-balanco-bg); margin-top: -6px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 6px;">
            <span style="font-size: 13px; color: var(--text-secondary);">Balanço do Mês</span>
            <span class="metric-card-info" style="color: var(--text-muted);" @onclick='() => ExplicarMetrica("balanco")'>ⓘ</span>
        </div>
        <span style="font-size: 20px; font-weight: 700; color: var(--text-primary);">@SaldoMes.ToString("C2", PtBr)</span>
    </div>
</div>

<!-- Barra Visual de Proporção Receitas vs Despesas -->
@if (TotalReceitasMes > 0)
{
    <div class="native-card" style="padding: 14px 12px; margin-top: -6px;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 6px;">
            <span style="color: var(--text-muted);">Comprometimento das receitas</span>
            <span style="color: var(--text-secondary); font-weight: 700;">Despesas representam @((ProporcaoDespesas * 100).ToString("F0"))% das receitas</span>
        </div>
        <div style="width: 100%; height: 6px; background-color: var(--card-receitas-bg); border-radius: 999px; overflow: hidden;">
            <div style="width: @Math.Min(100, ProporcaoDespesas * 100)%; height: 100%; background-color: #f87171; transition: width 0.3s;"></div>
        </div>
    </div>
}

<!-- Filtros Rápidos com Botões Proporcionais -->
<div style="display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 12px;">
    <button class="@(FiltroTipo == "Todos" && FiltroStatus == "Todos" ? "btn-native-blue" : "btn-native-gray")" style="padding: 6px 12px; font-size: 12px;" @onclick='() => SetFiltro("Todos", "Todos")'>
        Todos
    </button>
    <button class="@(FiltroTipo == "Receita" ? "btn-native-blue" : "btn-native-gray")" style="padding: 6px 12px; font-size: 12px;" @onclick='() => SetFiltro("Receita", "Todos")'>
        Receitas
    </button>
    <button class="@(FiltroTipo == "Despesa" && FiltroStatus == "Todos" ? "btn-native-blue" : "btn-native-gray")" style="padding: 6px 12px; font-size: 12px;" @onclick='() => SetFiltro("Despesa", "Todos")'>
        Despesas
    </button>
    <button class="@(FiltroStatus == "Paga" ? "btn-native-blue" : "btn-native-gray")" style="padding: 6px 12px; font-size: 12px;" @onclick='() => SetFiltro("Todos", "Paga")'>
        Pagas / Recebidas
    </button>
    <button class="@(FiltroStatus == "Pendente" ? "btn-native-blue" : "btn-native-gray")" style="padding: 6px 12px; font-size: 12px;" @onclick='() => SetFiltro("Todos", "Pendente")'>
        Pendentes / A Receber
    </button>
</div>

<!-- Campo de Busca -->
<div class="form-field" style="margin-bottom: 16px;">
    <input type="text" class="native-input" placeholder="Buscar por descrição..." @bind="TermoBusca" @bind:event="oninput" />
</div>

<!-- Lista de Transações Filtradas -->
<div style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 10px;">
    Lançamentos (@ItensFiltrados.Count)
</div>

@if (ItensFiltrados.Count == 0)
{
    <div style="padding: 24px; text-align: center; color: var(--text-gray-500); font-size: 13px; background: var(--bg-card); border-radius: 12px; border: 1px dashed var(--border-card);">
        Nenhum lançamento encontrado para os filtros selecionados.
    </div>
}
else
{
    @foreach (var item in ItensFiltrados)
    {
        <div class="trans-item-card">
            <div class="trans-item-top">
                @if (item.Tipo == "Despesa")
                {
                    <span class="badge-status-pill @(item.Paga ? "badge-paga" : "badge-pendente")"
                          @onclick="() => AlternarStatusItem(item)">
                        @(item.Paga ? "✓ PAGA" : "⏳ PENDENTE")
                    </span>
                }
                else
                {
                    <span class="badge-status-pill @(item.Recebida ? "badge-paga" : "badge-pendente")"
                          @onclick="() => AlternarStatusItem(item)">
                        @(item.Recebida ? "✓ RECEBIDA" : "⏳ A RECEBER")
                    </span>
                }
                <span class="trans-title">@item.Descricao</span>
                <span class="@(item.Tipo == "Receita" ? "trans-val-green" : "trans-val-red")">
                    @(item.Tipo == "Receita" ? "+ " : "- ")@item.Valor.ToString("C2", PtBr)
                </span>
            </div>
            <div class="trans-item-bottom">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span>@(item.Vencimento.HasValue ? $"Venc.: {item.Vencimento.Value:dd/MM/yyyy}" : $"Data: {item.Data:dd/MM/yyyy}")</span>
                    @if (item.Recorrente)
                    {
                        <span style="color: #a78bfa; font-size: 11px;">• Recorrente</span>
                    }
                </div>
                <div style="display: flex; gap: 6px;">
                    <button class="btn-small-edit" @onclick="() => AbrirEdicao(item)">Editar</button>
                    <button class="btn-small-delete" @onclick="() => ExcluirTransacao(item)">Excluir</button>
                </div>
            </div>
        </div>
    }
}

<!-- Modal de Edição -->
@if (IsEditModalVisible)
{
    <div class="modal-overlay" @onclick="FecharModalEdicao">
        <div class="modal-dialog-box" @onclick:stopPropagation="true">
            <div class="modal-title-text">@EditModalTitle</div>
            <div class="form-field">
                <input type="text" class="native-input" placeholder="Descrição" @bind="EditDescricao" />
            </div>
            <div class="form-field">
                <input type="number" step="0.01" class="native-input" placeholder="Valor" @bind="EditValor" />
            </div>
            <div class="form-field">
                <label class="form-label">Data</label>
                <input type="date" class="native-input" @bind="EditData" />
            </div>

            @if (IsEditingDespesa)
            {
                <div class="form-field">
                    <label class="form-label">Data de Vencimento</label>
                    <input type="date" class="native-input" @bind="EditVencimento" />
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                    <span style="font-size: 14px; color: var(--text-primary);">Despesa recorrente</span>
                    <div class="toggle-switch" @onclick="() => EditRecorrente = !EditRecorrente">
                        <input type="checkbox" checked="@EditRecorrente" />
                        <span class="slider"></span>
                    </div>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <span style="font-size: 14px; color: var(--text-primary);">Despesa já paga</span>
                    <div class="toggle-switch" @onclick="() => EditPaga = !EditPaga">
                        <input type="checkbox" checked="@EditPaga" />
                        <span class="slider"></span>
                    </div>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; margin-top: 8px;">
                    <span style="font-size: 14px; color: var(--text-primary);">Receita já recebida</span>
                    <div class="toggle-switch" @onclick="() => EditRecebida = !EditRecebida">
                        <input type="checkbox" checked="@EditRecebida" />
                        <span class="slider"></span>
                    </div>
                </div>
            }

            <div style="display: flex; gap: 12px; margin-top: 12px;">
                <button class="btn-native-blue" style="flex: 1;" @onclick="SalvarEdicaoModal">Atualizar</button>
                <button class="btn-native-gray" style="flex: 1;" @onclick="FecharModalEdicao">Cancelar</button>
            </div>
        </div>
    </div>
}

<!-- Modal Explicativo -->
@if (ExplicacaoTitulo != null)
{
    <div class="modal-overlay" @onclick="FecharExplicacao">
        <div class="modal-dialog-box" @onclick:stopPropagation="true">
            <div class="modal-title-text">@ExplicacaoTitulo</div>
            <div style="font-size: 14px; color: var(--text-gray-300); line-height: 1.6; white-space: pre-line; margin-bottom: 20px;">
                @ExplicacaoTexto
            </div>
            <button class="btn-native-blue" style="width: 100%;" @onclick="FecharExplicacao">
                Entendi
            </button>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private DateTime DataReferencia = DateTime.Today;
    private List<TransacaoItem> TodasTransacoes = [];
    private decimal TotalReceitasMes = 0;
    private decimal TotalDespesasMes = 0;
    private decimal SaldoMes => TotalReceitasMes - TotalDespesasMes;
    private decimal TotalDespesasPagasMes = 0;
    private decimal TotalDespesasPendentesMes = 0;
    private double ProporcaoDespesas => TotalReceitasMes > 0 ? (double)(TotalDespesasMes / TotalReceitasMes) : 0;

    private string TermoBusca = string.Empty;
    private string FiltroTipo = "Todos";
    private string FiltroStatus = "Todos";

    // Modal de Edição
    private bool IsEditModalVisible = false;
    private bool IsEditingDespesa = false;
    private Guid? EditId;
    private Guid? EditCategoriaId;
    private string EditModalTitle = "Editar";
    private string EditDescricao = string.Empty;
    private decimal EditValor;
    private DateTime EditData = DateTime.Today;
    private DateTime? EditVencimento;
    private bool EditRecorrente;
    private bool EditPaga;
    private bool EditRecebida = true;

    private string? ExplicacaoTitulo;
    private string? ExplicacaoTexto;

    private string NomeMesAno => DataReferencia.ToString("MMMM yyyy", PtBr);
    private bool IsMesDiferenteDoAtual => DataReferencia.Year != DateTime.Today.Year || DataReferencia.Month != DateTime.Today.Month;

    private List<TransacaoItem> ItensFiltrados => TodasTransacoes
        .Where(t =>
        {
            if (FiltroTipo != "Todos" && !string.Equals(t.Tipo, FiltroTipo, StringComparison.OrdinalIgnoreCase))
                return false;

            if (FiltroStatus == "Paga")
            {
                if (t.Tipo == "Despesa" && !t.Paga) return false;
                if (t.Tipo == "Receita" && !t.Recebida) return false;
            }
            if (FiltroStatus == "Pendente")
            {
                if (t.Tipo == "Despesa" && t.Paga) return false;
                if (t.Tipo == "Receita" && t.Recebida) return false;
            }

            if (!string.IsNullOrWhiteSpace(TermoBusca))
            {
                var matchDesc = t.Descricao.Contains(TermoBusca, StringComparison.OrdinalIgnoreCase);
                var matchCat = t.CategoriaNome.Contains(TermoBusca, StringComparison.OrdinalIgnoreCase);
                if (!matchDesc && !matchCat)
                    return false;
            }

            return true;
        })
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        FinanceService.OnChange += OnStateChanged;
        await CarregarDadosAsync();
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await CarregarDadosAsync();
        });
    }

    public void Dispose()
    {
        FinanceService.OnChange -= OnStateChanged;
    }

    private async Task CarregarDadosAsync()
    {
        var receitas = await FinanceService.GetReceitasMesAsync(DataReferencia.Year, DataReferencia.Month);
        var despesas = await FinanceService.GetDespesasMesAsync(DataReferencia.Year, DataReferencia.Month);

        TotalReceitasMes = receitas.Where(r => r.Recebida).Sum(r => r.Valor);
        TotalDespesasMes = despesas.Sum(d => d.Valor);
        TotalDespesasPagasMes = despesas.Where(d => d.Paga).Sum(d => d.Valor);
        TotalDespesasPendentesMes = despesas.Where(d => !d.Paga).Sum(d => d.Valor);

        TodasTransacoes = await FinanceService.GetTransacoesMesAsync(DataReferencia.Year, DataReferencia.Month);
        StateHasChanged();
    }

    private async Task MesAnterior()
    {
        DataReferencia = DataReferencia.AddMonths(-1);
        await CarregarDadosAsync();
    }

    private async Task ProximoMes()
    {
        DataReferencia = DataReferencia.AddMonths(1);
        await CarregarDadosAsync();
    }

    private async Task VoltarMesAtual()
    {
        DataReferencia = DateTime.Today;
        await CarregarDadosAsync();
    }

    private void SetFiltro(string tipo, string status)
    {
        FiltroTipo = tipo;
        FiltroStatus = status;
    }

    private async Task AlternarStatusItem(TransacaoItem item)
    {
        await JSRuntime.InvokeVoidAsync("manyControlJs.vibrate", 30);
        if (item.Tipo == "Despesa")
        {
            await FinanceService.TogglePagaDespesaAsync(item.Id);
        }
        else
        {
            await FinanceService.ToggleRecebidaReceitaAsync(item.Id);
        }
        await CarregarDadosAsync();
    }

    private void AbrirEdicao(TransacaoItem item)
    {
        IsEditingDespesa = item.Tipo == "Despesa";
        EditId = item.Id;
        EditCategoriaId = item.CategoriaId;
        EditModalTitle = item.Tipo == "Despesa" ? "Editar Despesa" : "Editar Receita";
        EditDescricao = item.Descricao;
        EditValor = item.Valor;
        EditData = item.Data;
        EditVencimento = item.Vencimento;
        EditRecorrente = item.Recorrente;
        EditPaga = item.Paga;
        EditRecebida = item.Recebida;
        IsEditModalVisible = true;
    }

    private async Task SalvarEdicaoModal()
    {
        if (!EditId.HasValue)
            return;

        if (string.IsNullOrWhiteSpace(EditDescricao))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Informe uma descrição válida.");
            return;
        }

        if (EditValor <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "O valor deve ser maior que zero.");
            return;
        }

        if (IsEditingDespesa)
        {
            await FinanceService.UpdateDespesaAsync(new Despesa
            {
                Id = EditId.Value,
                Descricao = EditDescricao.Trim(),
                Valor = EditValor,
                Data = EditData,
                Vencimento = EditVencimento,
                Recorrente = EditRecorrente,
                Paga = EditPaga,
                CategoriaId = EditCategoriaId
            });
        }
        else
        {
            await FinanceService.UpdateReceitaAsync(new Receita
            {
                Id = EditId.Value,
                Descricao = EditDescricao.Trim(),
                Valor = EditValor,
                Data = EditData,
                Recebida = EditRecebida,
                CategoriaId = EditCategoriaId
            });
        }

        FecharModalEdicao();
        await CarregarDadosAsync();
    }

    private void FecharModalEdicao()
    {
        IsEditModalVisible = false;
        EditId = null;
        EditCategoriaId = null;
    }

    private async Task ExcluirTransacao(TransacaoItem item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja excluir '{item.Descricao}'?");
        if (confirm)
        {
            if (item.Tipo == "Receita")
            {
                await FinanceService.DeleteReceitaAsync(item.Id);
            }
            else
            {
                await FinanceService.DeleteDespesaAsync(item.Id);
            }
            await CarregarDadosAsync();
        }
    }

    private void ExplicarMetrica(string metrica)
    {
        switch (metrica.ToLowerInvariant())
        {
            case "balanco":
                ExplicacaoTitulo = "Balanço do Mês";
                ExplicacaoTexto = "É o que sobrou (ou faltou) exclusivamente neste mês selecionado.\n\n• Fórmula: Receitas do Mês − Despesas do Mês\n\nMostra se as suas contas fecharam no positivo ou negativo no período.";
                break;
            case "receitas":
                ExplicacaoTitulo = "Entradas do Mês";
                ExplicacaoTexto = "Soma de todas as entradas financeiras registradas neste mês (ex: salários, rendimentos, vendas).";
                break;
            case "despesas":
                ExplicacaoTitulo = "Saídas do Mês";
                ExplicacaoTexto = "Soma de todas as saídas e gastos cadastrados para este mês (inclui tanto contas já pagas quanto contas pendentes).";
                break;
            case "pendentes":
                ExplicacaoTitulo = "A Pagar (Pendente)";
                ExplicacaoTexto = "Total de contas deste mês que você ainda não marcou como pagas. Ideal para acompanhar o compromisso financeiro restante.";
                break;
            case "pagas":
                ExplicacaoTitulo = "Já Pago";
                ExplicacaoTexto = "Total de contas deste mês que já foram quitadas e pagas.";
                break;
        }
    }

    private void FecharExplicacao()
    {
        ExplicacaoTitulo = null;
        ExplicacaoTexto = null;
    }
}
