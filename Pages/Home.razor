@page "/"
@using ManyControl_Web.Models
@using ManyControl_Web.Services
@using ManyControl_Web.Components
@inject FinanceWebService FinanceService
@inject IJSRuntime JSRuntime

<PageTitle>ManyControl - Início</PageTitle>

<PwaInstallPrompt />

<!-- Navegador de Mês -->
<div class="month-selector">
    <button class="month-btn" @onclick="MesAnterior" title="Mês anterior">
        <i class="bi bi-chevron-left"></i>
    </button>
    <div style="display: flex; flex-direction: column; align-items: center;">
        <div class="month-label" @onclick="VoltarMesAtual" style="cursor: pointer;" title="Clique para voltar ao mês atual">
            @NomeMesAno
        </div>
        @if (IsMesDiferenteDoAtual)
        {
            <button style="background: transparent; border: none; color: var(--color-blue); font-size: 11px; font-weight: 700; cursor: pointer; padding: 2px 6px;" @onclick="VoltarMesAtual">
                <i class="bi bi-arrow-counterclockwise"></i> Ir para o mês atual
            </button>
        }
    </div>
    <button class="month-btn" @onclick="ProximoMes" title="Próximo mês">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<!-- Cards de Resumo Grid 2x3 -->
<div class="summary-grid">
    <!-- Balanço do Mês -->
    <div class="summary-card">
        <div class="summary-header">
            <span class="summary-title">Balanço do Mês</span>
            <span class="summary-info-btn" @onclick='() => ExplicarMetrica("balanco")' title="O que é?">ⓘ</span>
        </div>
        <div class="summary-value @(BalancoMes >= 0 ? "value-green" : "value-red")">
            @(BalancoMes >= 0 ? "+ " : "")@BalancoMes.ToString("C2", PtBr)
        </div>
        <div class="summary-footer">
            Receitas − Despesas deste mês
        </div>
    </div>

    <!-- Saldo Geral (Conta) -->
    <div class="summary-card" style="background: linear-gradient(135deg, #13122b 0%, #1a193d 100%); border-color: rgba(99, 102, 241, 0.3);">
        <div class="summary-header">
            <span class="summary-title" style="color: #c7d2fe;">Saldo Geral (Conta)</span>
            <span class="summary-info-btn" style="color: #c7d2fe;" @onclick='() => ExplicarMetrica("saldo")' title="O que é?">ⓘ</span>
        </div>
        <div class="summary-value @(SaldoGeral >= 0 ? "value-green" : "value-red")">
            @(SaldoGeral >= 0 ? "+ " : "")@SaldoGeral.ToString("C2", PtBr)
        </div>
        <div class="summary-footer" style="color: #818cf8;">
            Acumulado de todas as contas
        </div>
    </div>

    <!-- Receitas do Mês -->
    <div class="summary-card">
        <div class="summary-header">
            <span class="summary-title">Receitas</span>
            <span class="summary-info-btn" @onclick='() => ExplicarMetrica("receitas")'>ⓘ</span>
        </div>
        <div class="summary-value value-green">
            @TotalReceitas.ToString("C2", PtBr)
        </div>
        <div class="summary-footer">
            @CountReceitas lançamento(s)
        </div>
    </div>

    <!-- Despesas do Mês -->
    <div class="summary-card">
        <div class="summary-header">
            <span class="summary-title">Despesas</span>
            <span class="summary-info-btn" @onclick='() => ExplicarMetrica("despesas")'>ⓘ</span>
        </div>
        <div class="summary-value value-red">
            @TotalDespesas.ToString("C2", PtBr)
        </div>
        <div class="summary-footer">
            @CountDespesas lançamento(s)
        </div>
    </div>

    <!-- A Pagar (Pendente) -->
    <div class="summary-card">
        <div class="summary-header">
            <span class="summary-title">A Pagar (Pendente)</span>
            <span class="summary-info-btn" @onclick='() => ExplicarMetrica("pendentes")'>ⓘ</span>
        </div>
        <div class="summary-value" style="color: var(--color-amber);">
            @TotalPendentes.ToString("C2", PtBr)
        </div>
        <div class="summary-footer">
            Contas em aberto
        </div>
    </div>

    <!-- Já Pago -->
    <div class="summary-card">
        <div class="summary-header">
            <span class="summary-title">Já Pago</span>
            <span class="summary-info-btn" @onclick='() => ExplicarMetrica("pagas")'>ⓘ</span>
        </div>
        <div class="summary-value" style="color: var(--color-green);">
            @TotalPagas.ToString("C2", PtBr)
        </div>
        <div class="summary-footer">
            Contas liquidadas
        </div>
    </div>
</div>

<!-- Ações Rápidas -->
<div class="actions-row">
    <button class="btn-action btn-receita" @onclick='() => AbrirNovoModal("Receita")'>
        <i class="bi bi-plus-circle-fill"></i> Nova Receita
    </button>
    <button class="btn-action btn-despesa" @onclick='() => AbrirNovoModal("Despesa")'>
        <i class="bi bi-dash-circle-fill"></i> Nova Despesa
    </button>
</div>

<!-- Lista de Transações Recentes -->
<div class="section-header">
    <div class="section-title">
        <i class="bi bi-clock-history"></i> Lançamentos de @NomeMesAno
    </div>
    <div class="section-count">@Transacoes.Count registros</div>
</div>

@if (Transacoes.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-inbox"></i></div>
        <div style="font-weight: 700; color: #ffffff; margin-bottom: 6px;">Nenhum lançamento neste mês</div>
        <div style="font-size: 13px; margin-bottom: 16px;">Clique nos botões acima para cadastrar receitas e despesas.</div>
    </div>
}
else
{
    <div class="transaction-list">
        @foreach (var item in Transacoes)
        {
            <div class="transaction-card" @onclick="() => EditarTransacao(item)">
                <div class="trans-left">
                    <div class="trans-icon @(item.Tipo == "Receita" ? "icon-green" : "icon-red")">
                        <i class="bi @(item.Tipo == "Receita" ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
                    </div>
                    <div class="trans-info">
                        <div class="trans-desc">@item.Descricao</div>
                        <div class="trans-meta">
                            <span>@item.Data.ToString("dd/MM/yyyy")</span>
                            <span class="badge-tag">@item.CategoriaNome</span>
                            @if (item.Recorrente)
                            {
                                <span class="badge-recorrente"><i class="bi bi-repeat"></i> Fixa</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="trans-right">
                    <div class="trans-val @(item.Tipo == "Receita" ? "value-green" : "value-red")">
                        @(item.Tipo == "Receita" ? "+ " : "- ")@item.Valor.ToString("C2", PtBr)
                    </div>
                    @if (item.Tipo == "Despesa")
                    {
                        <div class="status-badge @(item.Paga ? "status-paga" : "status-pendente")"
                             @onclick:stopPropagation="true"
                             @onclick="() => ToggleStatusPaga(item)"
                             title="Clique para alternar pago/pendente">
                            <i class="bi @(item.Paga ? "bi-check-circle-fill" : "bi-hourglass-split")"></i>
                            @(item.Paga ? "Paga" : "Pendente")
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<ModalTransacao @ref="modalTransacao" OnSaved="CarregarDadosAsync" />

<!-- Modal Explicativo de Métricas -->
@if (ExplicacaoTitulo != null)
{
    <div class="modal-overlay" @onclick="FecharExplicacao">
        <div class="modal-sheet" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">@ExplicacaoTitulo</div>
                <button class="btn-close-modal" @onclick="FecharExplicacao">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div style="font-size: 14px; color: var(--text-secondary); line-height: 1.6; white-space: pre-line; margin-bottom: 20px;">
                @ExplicacaoTexto
            </div>
            <button class="btn-primary" @onclick="FecharExplicacao">
                Entendi
            </button>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private ModalTransacao? modalTransacao;
    private DateTime DataReferencia = DateTime.Today;
    private List<TransacaoItem> Transacoes = [];

    private decimal TotalReceitas = 0;
    private decimal TotalDespesas = 0;
    private decimal BalancoMes => TotalReceitas - TotalDespesas;
    private decimal SaldoGeral = 0;
    private decimal TotalPagas = 0;
    private decimal TotalPendentes = 0;
    private int CountReceitas = 0;
    private int CountDespesas = 0;

    private string? ExplicacaoTitulo;
    private string? ExplicacaoTexto;

    private string NomeMesAno => DataReferencia.ToString("MMMM yyyy", PtBr);
    private bool IsMesDiferenteDoAtual => DataReferencia.Year != DateTime.Today.Year || DataReferencia.Month != DateTime.Today.Month;

    protected override async Task OnInitializedAsync()
    {
        FinanceService.OnChange += StateHasChanged;
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        var ano = DataReferencia.Year;
        var mes = DataReferencia.Month;

        var receitas = await FinanceService.GetReceitasMesAsync(ano, mes);
        var despesas = await FinanceService.GetDespesasMesAsync(ano, mes);

        TotalReceitas = receitas.Sum(r => r.Valor);
        TotalDespesas = despesas.Sum(d => d.Valor);
        TotalPagas = despesas.Where(d => d.Paga).Sum(d => d.Valor);
        TotalPendentes = despesas.Where(d => !d.Paga).Sum(d => d.Valor);

        CountReceitas = receitas.Count;
        CountDespesas = despesas.Count;

        SaldoGeral = await FinanceService.GetSaldoGeralAcumuladoAsync();
        Transacoes = await FinanceService.GetTransacoesMesAsync(ano, mes);
        StateHasChanged();
    }

    private async Task MesAnterior()
    {
        DataReferencia = DataReferencia.AddMonths(-1);
        await CarregarDadosAsync();
    }

    private async Task ProximoMes()
    {
        DataReferencia = DataReferencia.AddMonths(1);
        await CarregarDadosAsync();
    }

    private async Task VoltarMesAtual()
    {
        DataReferencia = DateTime.Today;
        await CarregarDadosAsync();
    }

    private async Task AbrirNovoModal(string tipo)
    {
        if (modalTransacao != null)
        {
            await modalTransacao.AbrirNovoAsync(tipo, DataReferencia);
        }
    }

    private async Task EditarTransacao(TransacaoItem item)
    {
        if (modalTransacao != null)
        {
            await modalTransacao.AbrirEdicaoAsync(item);
        }
    }

    private async Task ToggleStatusPaga(TransacaoItem item)
    {
        await JSRuntime.InvokeVoidAsync("manyControlJs.vibrate", 30);
        await FinanceService.TogglePagaDespesaAsync(item.Id);
        await CarregarDadosAsync();
    }

    private void ExplicarMetrica(string metrica)
    {
        switch (metrica.ToLowerInvariant())
        {
            case "balanco":
                ExplicacaoTitulo = "Balanço do Mês";
                ExplicacaoTexto = "É o que sobrou (ou faltou) exclusivamente neste mês selecionado.\n\n• Fórmula: Receitas do Mês − Despesas do Mês\n\nMostra se as suas contas fecharam no positivo ou negativo no período.";
                break;
            case "saldo":
                ExplicacaoTitulo = "Saldo Geral (Conta)";
                ExplicacaoTexto = "Representa o saldo financeiro acumulado total na sua conta, considerando todo o histórico de receitas e despesas registradas no ManyControl.";
                break;
            case "receitas":
                ExplicacaoTitulo = "Receitas do Mês";
                ExplicacaoTexto = "Soma de todas as entradas financeiras registradas neste mês (ex: salários, rendimentos, vendas).";
                break;
            case "despesas":
                ExplicacaoTitulo = "Despesas do Mês";
                ExplicacaoTexto = "Soma de todas as saídas e gastos cadastrados para este mês (inclui tanto contas já pagas quanto contas pendentes).";
                break;
            case "pendentes":
                ExplicacaoTitulo = "A Pagar (Pendente)";
                ExplicacaoTexto = "Total de contas deste mês que você ainda não marcou como pagas. Ideal para acompanhar o compromisso financeiro restante.";
                break;
            case "pagas":
                ExplicacaoTitulo = "Já Pago";
                ExplicacaoTexto = "Total de contas deste mês que já foram quitadas e pagas.";
                break;
        }
    }

    private void FecharExplicacao()
    {
        ExplicacaoTitulo = null;
        ExplicacaoTexto = null;
    }
}
