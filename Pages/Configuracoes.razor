@page "/configuracoes"
@using ManyControl_Web.Models
@using ManyControl_Web.Services
@inject FinanceWebService FinanceService
@inject BackupService BackupService
@inject GoogleDriveWebService GoogleDriveService
@inject VersaoService VersaoService
@inject ThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>ManyControl - Sincronização</PageTitle>

<!-- Card: Aparência / Tema do Aplicativo -->
<div class="native-card">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div style="font-size: 18px; font-weight: 700; color: var(--text-primary);">Aparência do Aplicativo</div>
        <span style="font-size: 12px; color: var(--text-gray-400);">@(ThemeService.IsDark ? "Tema Escuro" : "Tema Claro")</span>
    </div>
    <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.5;">
        Escolha entre o tema escuro confortável para a visão ou o tema claro de alto contraste e elegância.
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px;">
        <button class="@(ThemeService.IsDark ? "btn-native-blue" : "btn-native-gray")" style="min-height: 44px;" @onclick='() => SetTheme("dark")'>
            <i class="bi bi-moon-stars-fill"></i> Tema Escuro
        </button>
        <button class="@(ThemeService.IsLight ? "btn-native-blue" : "btn-native-gray")" style="min-height: 44px;" @onclick='() => SetTheme("light")'>
            <i class="bi bi-sun-fill"></i> Tema Claro
        </button>
    </div>

    <!-- Seção: Personalização da Cor do Seletor e Destaques -->
    <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-card);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
            <div style="font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-palette-fill" style="color: var(--bottom-nav-active);"></i> Cor do Seletor e Destaque
            </div>
            @if (!string.IsNullOrEmpty(ThemeService.CustomAccentColor))
            {
                <button type="button" class="btn-native-gray" style="padding: 4px 10px; font-size: 11px; min-height: 0; height: auto;" @onclick="ResetAccentColor" title="Restaurar cor padrão">
                    Restaurar Padrão
                </button>
            }
        </div>
        <div style="font-size: 13px; color: var(--text-gray-400); margin-bottom: 12px; line-height: 1.4;">
            Personalize a cor da casinha e do seletor da barra de navegação para combinar com o seu estilo.
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
            @foreach (var cor in PresetColors)
            {
                var isSelected = IsAccentSelected(cor.Hex);
                <button type="button"
                        class="accent-color-btn @(isSelected ? "selected" : "")"
                        style="background-color: @cor.Hex;"
                        title="@cor.Name"
                        aria-label="@cor.Name"
                        @onclick="() => SelectAccentColor(cor.Hex)">
                    @if (isSelected)
                    {
                        <i class="bi bi-check-lg" style="color: #ffffff; font-size: 18px; text-shadow: 0 1px 2px rgba(0,0,0,0.7);"></i>
                    }
                </button>
            }

            <!-- Seletor Livre / Color Picker -->
            <label class="accent-color-btn custom-picker-btn" title="Escolher cor personalizada" aria-label="Escolher cor personalizada" style="background: conic-gradient(from 180deg, red, yellow, lime, aqua, blue, magenta, red); cursor: pointer; position: relative;">
                <input type="color" value="@(ThemeService.ActiveAccentColor)" @onchange="OnCustomColorChanged" style="opacity: 0; position: absolute; width: 100%; height: 100%; cursor: pointer; top: 0; left: 0;" />
                <i class="bi bi-eyedropper" style="color: #ffffff; font-size: 14px; text-shadow: 0 1px 2px rgba(0,0,0,0.8); pointer-events: none;"></i>
            </label>
        </div>
    </div>
</div>

<!-- Card 1: Google Drive (Modo NÃO CONECTADO) -->
@if (!IsConnected)
{
    <div class="native-card">
        <div style="font-size: 20px; font-weight: 700; color: var(--text-primary);">Google Drive</div>
        <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.5;">
            Conecte sua conta do Google para sincronizar automaticamente seus dados na nuvem com backup duplo (pasta do Drive e armazenamento seguro).
        </div>

        <!-- Botão Oficial do Google com Logo SVG -->
        <div style="margin-top: 8px;">
            <button style="background-color: var(--bg-card); border: 1px solid var(--border-card); border-radius: 26px; padding: 12px 20px; display: inline-flex; align-items: center; gap: 12px; cursor: pointer; transition: all 0.15s;"
                    @onclick="ConectarGoogle">
                <img src="google_logo.svg" alt="Google" style="width: 22px; height: 22px;" />
                <span style="color: var(--text-primary); font-size: 15px; font-weight: 700;">Fazer login com o Google</span>
            </button>
        </div>
    </div>
}

<!-- Card 2: Google Drive (Modo CONECTADO) -->
@if (IsConnected)
{
    <div class="native-card">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <img src="google_logo.svg" alt="Google" style="width: 20px; height: 20px;" />
                <span style="font-size: 18px; font-weight: 700; color: #34d399;">Google Drive Conectado</span>
            </div>
            <span style="background-color: #064e3b; color: #a7f3d0; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                ● Ativo
            </span>
        </div>

        <div style="background-color: var(--bg-card-secondary); border: 1px solid var(--border-card); border-radius: 12px; padding: 12px 16px; margin: 6px 0;">
            <div style="font-size: 12px; color: var(--text-gray-400);">Conta Google vinculada:</div>
            <div style="font-size: 16px; font-weight: 700; color: var(--text-primary);">@ConnectedEmail</div>
            <div style="font-size: 12px; color: #10b981; margin-top: 4px;">Pasta de destino: 'ManyControl' na raiz do seu Drive.</div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 4px 0;">
            <div>
                <div style="font-size: 12px; color: var(--text-gray-400);">Última Sincronização</div>
                <div style="font-size: 14px; font-weight: 700; color: var(--text-primary);">@LastSyncText</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-gray-400);">Última Operação</div>
                <div style="font-size: 14px; color: var(--text-secondary);">Nuvem & Local</div>
            </div>
            <div style="grid-column: span 2;">
                <div style="font-size: 12px; color: var(--text-gray-400);">Status do Robô</div>
                <div style="font-size: 13px; font-weight: 700; color: #10b981;">@SyncStatusText</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px;">
            <button class="btn-native-blue" style="min-height: 44px;" @onclick="SincronizarGoogleAgora">
                <i class="bi bi-arrow-repeat"></i> Sincronizar Agora
            </button>
            <button class="btn-native-gray" style="min-height: 44px; color: #f87171;" @onclick="DesconectarGoogle">
                Desconectar Conta
            </button>
        </div>
    </div>
}

<!-- Card 3: Backups Manuais (Arquivos Locais em JSON) -->
<div class="native-card">
    <div style="font-size: 18px; font-weight: 700; color: var(--text-primary);">Backup Local (Arquivo Físico)</div>
    <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.5;">
        Exporte uma cópia de segurança física no seu computador ou restaure um backup antigo a qualquer momento sem precisar de internet.
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px;">
        <button class="btn-native-gray" style="min-height: 44px;" @onclick="ExportarBackup">Exportar Backup Local</button>
        <button class="btn-native-gray" style="min-height: 44px;" @onclick="TriggerImportFile">Restaurar de Arquivo</button>
    </div>

    <InputFile id="backupFileInput" OnChange="ProcessarArquivoImportado" style="display: none;" accept=".json" />

    @if (!string.IsNullOrEmpty(MensagemBackup))
    {
        <div style="font-size: 13px; color: #10b981; font-weight: 600; margin-top: 6px;">
            ✓ @MensagemBackup
        </div>
    }

    <div style="font-size: 11px; color: var(--text-gray-500); margin-top: 8px;">
        Armazenamento local: Navegador / PWA Cache
    </div>
</div>

<!-- Card 4: Atualizações do Aplicativo -->
<div class="native-card">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 18px; font-weight: 700; color: var(--text-primary);">Atualizações do ManyControl</div>
            <div style="font-size: 13px; color: var(--text-gray-400);">
                Versão Web PWA com atualizações automáticas instantâneas a cada lançamento.
            </div>
        </div>
        <span style="background-color: var(--bg-card-secondary); color: #0284c7; border: 1px solid var(--border-card); font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 12px; white-space: nowrap;">
            @VersaoService.VersaoAtual
        </span>
    </div>

    <!-- Caixa de Destaques da Versão Atual -->
    @{
        var versaoAtual = VersaoService.GetVersaoAtualInfo();
    }
    <div class="changelog-box">
        <div class="changelog-version-header">
            <div class="changelog-version-title">
                <i class="bi bi-stars"></i> Novidades da versão @versaoAtual.Numero
            </div>
            <div class="changelog-version-date">@versaoAtual.DataLancamento</div>
        </div>

        <div class="changelog-list">
            @foreach (var destaque in versaoAtual.Destaques)
            {
                <div class="changelog-item">
                    <i class="bi @destaque.Icone changelog-item-icon"></i>
                    <div class="changelog-item-content">
                        <div class="changelog-item-header">
                            <span class="changelog-badge @GetBadgeClass(destaque.Tipo)">@destaque.Tipo</span>
                            <span class="changelog-item-title">@destaque.Titulo</span>
                        </div>
                        <div class="changelog-item-desc">@destaque.Descricao</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div style="font-size: 13px; color: #cbd5e1; margin-top: 6px;">
        @UpdateStatusText
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px;">
        <button class="btn-native-blue" style="background-color: #0284c7; min-height: 44px;" @onclick="ChecarAtualizacao">
            <i class="bi bi-arrow-repeat"></i> Verificar Atualizações
        </button>
        <button class="btn-native-gray" style="min-height: 44px;" @onclick="AbrirHistoricoVersoes">
            <i class="bi bi-clock-history"></i> Histórico de Versões
        </button>
    </div>
</div>

<!-- Modal: Histórico Completo de Versões -->
@if (IsHistoricoModalOpen)
{
    <div class="modal-overlay" @onclick="FecharHistoricoVersoes">
        <div class="modal-dialog-box" @onclick:stopPropagation="true">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                <div class="modal-title-text" style="margin-bottom: 0;">Histórico de Atualizações</div>
                <button class="btn-close-modal" @onclick="FecharHistoricoVersoes">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 14px; max-height: 65vh; overflow-y: auto; padding-right: 4px;">
                @foreach (var versao in VersaoService.GetHistoricoVersoes())
                {
                    <div class="changelog-box" style="margin-top: 0; border-color: @(versao.IsAtual ? "#0284c7" : "#334155");">
                        <div class="changelog-version-header">
                            <div class="changelog-version-title" style="color: @(versao.IsAtual ? "#38bdf8" : "#e2e8f0");">
                                <span>@versao.Numero - @versao.Titulo</span>
                                @if (versao.IsAtual)
                                {
                                    <span style="background-color: #065f46; color: #a7f3d0; font-size: 10px; padding: 2px 6px; border-radius: 6px;">Atual</span>
                                }
                            </div>
                            <div class="changelog-version-date">@versao.DataLancamento</div>
                        </div>

                        <div class="changelog-list">
                            @foreach (var destaque in versao.Destaques)
                            {
                                <div class="changelog-item">
                                    <i class="bi @destaque.Icone changelog-item-icon"></i>
                                    <div class="changelog-item-content">
                                        <div class="changelog-item-header">
                                            <span class="changelog-badge @GetBadgeClass(destaque.Tipo)">@destaque.Tipo</span>
                                            <span class="changelog-item-title">@destaque.Titulo</span>
                                        </div>
                                        <div class="changelog-item-desc">@destaque.Descricao</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div style="margin-top: 16px;">
                <button class="btn-native-blue" style="width: 100%;" @onclick="FecharHistoricoVersoes">
                    Fechar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsConnected = false;
    private string ConnectedEmail = "Conectado";
    private string LastSyncText = "Hoje";
    private string SyncStatusText = "● Tudo sincronizado";
    private string MensagemBackup = string.Empty;
    private string UpdateStatusText = "Toque em 'Verificar Atualizações' para forçar a sincronização da versão mais recente no seu aparelho.";
    private bool IsHistoricoModalOpen = false;

    private DotNetObjectReference<GoogleDriveWebService>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(GoogleDriveService);
        GoogleDriveService.OnStatusChanged += AtualizarEstado;
        ThemeService.OnThemeChanged += OnThemeChangedHandler;
        await VersaoService.CarregarChangelogAsync();
        await CarregarEstadoAsync();
    }

    private void OnThemeChangedHandler()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CarregarEstadoAsync()
    {
        IsConnected = await GoogleDriveService.IsConnectedAsync();
        if (IsConnected)
        {
            ConnectedEmail = await GoogleDriveService.GetConnectedEmailAsync() ?? "Conta Conectada";
        }
        LastSyncText = await GoogleDriveService.GetLastSyncTextAsync();
        StateHasChanged();
    }

    private void AtualizarEstado()
    {
        _ = InvokeAsync(async () =>
        {
            await CarregarEstadoAsync();
        });
    }

    private async Task ConectarGoogle()
    {
        if (_dotNetRef != null)
        {
            await GoogleDriveService.ConectarAsync(_dotNetRef);
        }
    }

    private async Task DesconectarGoogle()
    {
        await GoogleDriveService.DesconectarAsync();
        await CarregarEstadoAsync();
    }

    private async Task SincronizarGoogleAgora()
    {
        SyncStatusText = "Sincronizando...";
        StateHasChanged();
        var res = await GoogleDriveService.SincronizarAsync();
        SyncStatusText = res == "Tudo sincronizado" ? "● Tudo sincronizado" : res;
        LastSyncText = await GoogleDriveService.GetLastSyncTextAsync();
        StateHasChanged();
    }

    private async Task ExportarBackup()
    {
        await BackupService.ExportarBackupAsync();
        MensagemBackup = "Arquivo de backup exportado com sucesso!";
    }

    private async Task TriggerImportFile()
    {
        await JSRuntime.InvokeVoidAsync("manyControlJs.triggerFileInput", "backupFileInput");
    }

    private async Task ProcessarArquivoImportado(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();

            var sucesso = await BackupService.ImportarBackupJsonAsync(json, false);
            if (sucesso)
            {
                MensagemBackup = "Dados restaurados com sucesso!";
            }
        }
        catch (Exception ex)
        {
            MensagemBackup = $"Erro ao restaurar: {ex.Message}";
        }
    }

    private async Task ChecarAtualizacao()
    {
        UpdateStatusText = "Limpando cache e recarregando para a versão mais recente...";
        StateHasChanged();
        await Task.Delay(300);
        await JSRuntime.InvokeVoidAsync("manyControlJs.forceUpdateAndReload");
    }

    private void AbrirHistoricoVersoes()
    {
        IsHistoricoModalOpen = true;
    }

    private void FecharHistoricoVersoes()
    {
        IsHistoricoModalOpen = false;
    }

    private string GetBadgeClass(string tipo)
    {
        return tipo.ToLowerInvariant() switch
        {
            "ajuste" => "badge-ajuste",
            "novidade" => "badge-novidade",
            "melhoria" => "badge-melhoria",
            _ => "badge-ajuste"
        };
    }

    private async Task SetTheme(string theme)
    {
        await ThemeService.SetThemeAsync(theme);
        StateHasChanged();
    }

    private record AccentColorOption(string Name, string Hex);

    private readonly List<AccentColorOption> PresetColors = new()
    {
        new("Azul ManyControl", "#38bdf8"),
        new("Azul Royal", "#2563eb"),
        new("Verde Esmeralda", "#10b981"),
        new("Ciano Tropical", "#06b6d4"),
        new("Roxo Violeta", "#8b5cf6"),
        new("Rosa Magenta", "#ec4899"),
        new("Laranja Âmbar", "#f59e0b"),
        new("Vermelho Coral", "#ef4444")
    };

    private bool IsAccentSelected(string hex)
    {
        if (!string.IsNullOrEmpty(ThemeService.CustomAccentColor))
        {
            return string.Equals(ThemeService.CustomAccentColor, hex, StringComparison.OrdinalIgnoreCase);
        }
        var defaultHex = ThemeService.IsDark ? "#38bdf8" : "#0284c7";
        return string.Equals(defaultHex, hex, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SelectAccentColor(string hex)
    {
        await ThemeService.SetAccentColorAsync(hex);
        StateHasChanged();
    }

    private async Task ResetAccentColor()
    {
        await ThemeService.SetAccentColorAsync(null);
        StateHasChanged();
    }

    private async Task OnCustomColorChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val))
        {
            await ThemeService.SetAccentColorAsync(val);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        GoogleDriveService.OnStatusChanged -= AtualizarEstado;
        ThemeService.OnThemeChanged -= OnThemeChangedHandler;
        _dotNetRef?.Dispose();
    }
}
