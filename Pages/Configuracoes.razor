@page "/configuracoes"
@using ManyControl_Web.Models
@using ManyControl_Web.Services
@inject FinanceWebService FinanceService
@inject BackupService BackupService
@inject GoogleDriveWebService GoogleDriveService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>ManyControl - Sincronização</PageTitle>

<!-- Card 1: Google Drive (Modo NÃO CONECTADO) -->
@if (!IsConnected)
{
    <div class="native-card">
        <div style="font-size: 20px; font-weight: 700; color: #ffffff;">Google Drive</div>
        <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.5;">
            Conecte sua conta do Google para sincronizar automaticamente seus dados na nuvem com backup duplo (pasta do Drive e armazenamento seguro).
        </div>

        <!-- Botão Oficial do Google com Logo SVG -->
        <div style="margin-top: 8px;">
            <button style="background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 26px; padding: 12px 20px; display: inline-flex; align-items: center; gap: 12px; cursor: pointer; transition: all 0.15s;"
                    @onclick="ConectarGoogle">
                <img src="google_logo.svg" alt="Google" style="width: 22px; height: 22px;" />
                <span style="color: #1f2937; font-size: 15px; font-weight: 700;">Fazer login com o Google</span>
            </button>
        </div>
    </div>
}

<!-- Card 2: Google Drive (Modo CONECTADO) -->
@if (IsConnected)
{
    <div class="native-card">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <img src="google_logo.svg" alt="Google" style="width: 20px; height: 20px;" />
                <span style="font-size: 18px; font-weight: 700; color: #34d399;">Google Drive Conectado</span>
            </div>
            <span style="background-color: #064e3b; color: #a7f3d0; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                ● Ativo
            </span>
        </div>

        <div style="background-color: #1f2937; border: 1px solid var(--border-card); border-radius: 12px; padding: 12px 16px; margin: 6px 0;">
            <div style="font-size: 12px; color: var(--text-gray-400);">Conta Google vinculada:</div>
            <div style="font-size: 16px; font-weight: 700; color: #ffffff;">@ConnectedEmail</div>
            <div style="font-size: 12px; color: #6ee7b7; margin-top: 4px;">Pasta de destino: 'ManyControl' na raiz do seu Drive.</div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 4px 0;">
            <div>
                <div style="font-size: 12px; color: var(--text-gray-400);">Última Sincronização</div>
                <div style="font-size: 14px; font-weight: 700; color: #ffffff;">@LastSyncText</div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--text-gray-400);">Última Operação</div>
                <div style="font-size: 14px; color: #e5e7eb;">Nuvem & Local</div>
            </div>
            <div style="grid-column: span 2;">
                <div style="font-size: 12px; color: var(--text-gray-400);">Status do Robô</div>
                <div style="font-size: 13px; font-weight: 700; color: #a7f3d0;">@SyncStatusText</div>
            </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 8px;">
            <button class="btn-native-blue" style="height: 46px; font-size: 15px;" @onclick="SincronizarGoogleAgora">
                🔄 Sincronizar Agora
            </button>
            <button class="btn-native-gray" style="height: 46px; font-size: 14px; color: #f87171;" @onclick="DesconectarGoogle">
                Desconectar Conta
            </button>
        </div>
    </div>
}

<!-- Card 3: Backups Manuais (Arquivos Locais em JSON) -->
<div class="native-card">
    <div style="font-size: 18px; font-weight: 700; color: #ffffff;">Backup Local (Arquivo Físico)</div>
    <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.5;">
        Exporte uma cópia de segurança física no seu computador ou restaure um backup antigo a qualquer momento sem precisar de internet.
    </div>

    <div style="display: flex; gap: 12px; margin-top: 6px;">
        <button class="btn-native-gray" @onclick="ExportarBackup">Exportar Backup Local</button>
        <button class="btn-native-gray" @onclick="TriggerImportFile">Restaurar de Arquivo</button>
    </div>

    <InputFile id="backupFileInput" OnChange="ProcessarArquivoImportado" style="display: none;" accept=".json" />

    @if (!string.IsNullOrEmpty(MensagemBackup))
    {
        <div style="font-size: 13px; color: #34d399; font-weight: 600; margin-top: 6px;">
            ✓ @MensagemBackup
        </div>
    }

    <div style="font-size: 11px; color: var(--text-gray-500); margin-top: 8px;">
        Armazenamento local: Navegador / PWA Cache
    </div>
</div>

<!-- Card 4: Atualizações do Aplicativo -->
<div class="native-card">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
            <div style="font-size: 18px; font-weight: 700; color: #ffffff;">Atualizações do ManyControl</div>
            <div style="font-size: 13px; color: var(--text-gray-400);">
                Versão Web PWA com atualizações automáticas instantâneas a cada lançamento.
            </div>
        </div>
        <span style="background-color: #1e293b; color: #38bdf8; font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 12px; white-space: nowrap;">
            v1.0.14
        </span>
    </div>

    <div style="font-size: 13px; color: #cbd5e1; margin-top: 6px;">
        @UpdateStatusText
    </div>

    <div style="margin-top: 8px;">
        <button class="btn-native-blue" style="background-color: #0284c7;" @onclick="ChecarAtualizacao">
            Verificar Atualizações
        </button>
    </div>
</div>

@code {
    private bool IsConnected = false;
    private string ConnectedEmail = "Conectado";
    private string LastSyncText = "Hoje";
    private string SyncStatusText = "● Tudo sincronizado";
    private string MensagemBackup = string.Empty;
    private string UpdateStatusText = "O aplicativo já está na versão mais recente (v1.0.14)!";

    private DotNetObjectReference<GoogleDriveWebService>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(GoogleDriveService);
        GoogleDriveService.OnStatusChanged += AtualizarEstado;
        await CarregarEstadoAsync();
    }

    private async Task CarregarEstadoAsync()
    {
        IsConnected = await GoogleDriveService.IsConnectedAsync();
        if (IsConnected)
        {
            ConnectedEmail = await GoogleDriveService.GetConnectedEmailAsync() ?? "Conta Conectada";
        }
        LastSyncText = await GoogleDriveService.GetLastSyncTextAsync();
        StateHasChanged();
    }

    private void AtualizarEstado()
    {
        _ = InvokeAsync(async () =>
        {
            await CarregarEstadoAsync();
        });
    }

    private async Task ConectarGoogle()
    {
        if (_dotNetRef != null)
        {
            await GoogleDriveService.ConectarAsync(_dotNetRef);
        }
    }

    private async Task DesconectarGoogle()
    {
        await GoogleDriveService.DesconectarAsync();
        await CarregarEstadoAsync();
    }

    private async Task SincronizarGoogleAgora()
    {
        SyncStatusText = "Sincronizando...";
        StateHasChanged();
        var res = await GoogleDriveService.SincronizarAsync();
        SyncStatusText = res == "Tudo sincronizado" ? "● Tudo sincronizado" : res;
        LastSyncText = await GoogleDriveService.GetLastSyncTextAsync();
        StateHasChanged();
    }

    private async Task ExportarBackup()
    {
        await BackupService.ExportarBackupAsync();
        MensagemBackup = "Arquivo de backup exportado com sucesso!";
    }

    private async Task TriggerImportFile()
    {
        await JSRuntime.InvokeVoidAsync("manyControlJs.triggerFileInput", "backupFileInput");
    }

    private async Task ProcessarArquivoImportado(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();

            var sucesso = await BackupService.ImportarBackupJsonAsync(json, false);
            if (sucesso)
            {
                MensagemBackup = "Dados restaurados com sucesso!";
            }
        }
        catch (Exception ex)
        {
            MensagemBackup = $"Erro ao restaurar: {ex.Message}";
        }
    }

    private void ChecarAtualizacao()
    {
        UpdateStatusText = "Você já está utilizando a versão mais recente (v1.0.14)!";
    }

    public void Dispose()
    {
        GoogleDriveService.OnStatusChanged -= AtualizarEstado;
        _dotNetRef?.Dispose();
    }
}
