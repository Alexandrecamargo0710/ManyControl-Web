@page "/configuracoes"
@using ManyControl_Web.Models
@using ManyControl_Web.Services
@inject FinanceWebService FinanceService
@inject BackupService BackupService
@inject IJSRuntime JSRuntime

<PageTitle>ManyControl - Sincronização</PageTitle>

<!-- Card 1: Backup Local (Arquivo Físico) -->
<div class="native-card">
    <div style="font-size: 18px; font-weight: 700; color: #ffffff;">Backup Local (Arquivo Físico)</div>
    <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.5;">
        Exporte uma cópia de segurança física no seu dispositivo ou restaure um backup antigo a qualquer momento sem precisar de internet.
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px;">
        <button class="btn-native-gray" @onclick="ExportarBackup">Exportar Backup Local</button>
        <button class="btn-native-gray" @onclick="TriggerImportFile">Restaurar de Arquivo</button>
    </div>

    <InputFile id="backupFileInput" OnChange="ProcessarArquivoImportado" style="display: none;" accept=".json" />

    @if (!string.IsNullOrEmpty(MensagemBackup))
    {
        <div style="font-size: 13px; color: #34d399; font-weight: 600; margin-top: 6px;">
            ✓ @MensagemBackup
        </div>
    }
</div>

<!-- Card 2: Gerenciador de Categorias -->
<div class="native-card">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="font-size: 18px; font-weight: 700; color: #ffffff;">Gerenciar Categorias</div>
        <span style="font-size: 12px; color: var(--text-gray-400);">@Categorias.Count cadastradas</span>
    </div>

    <div style="display: flex; gap: 8px; margin-top: 6px;">
        <input type="text" class="native-input" style="flex: 2;" placeholder="Nome da categoria..." @bind="NovaCategoriaNome" />
        <select class="native-input" style="flex: 1;" @bind="NovaCategoriaTipo">
            <option value="Despesa">Despesa</option>
            <option value="Receita">Receita</option>
        </select>
        <button class="btn-native-blue" style="padding: 0 16px; font-size: 16px;" @onclick="AdicionarCategoriaAsync">+</button>
    </div>

    <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 8px; max-height: 240px; overflow-y: auto;">
        @foreach (var cat in Categorias)
        {
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--bg-card-secondary); border-radius: 8px; border: 1px solid var(--border-card);">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 14px; font-weight: 600; color: #ffffff;">@cat.Nome</span>
                    <span style="font-size: 10px; color: var(--text-gray-500); text-transform: uppercase;">(@cat.Tipo)</span>
                </div>
                <button style="background: transparent; border: none; color: var(--color-red-btn); cursor: pointer; font-size: 13px;" @onclick="() => ExcluirCategoriaAsync(cat.Id)">
                    Excluir
                </button>
            </div>
        }
    </div>
</div>

<!-- Card 3: Sobre e Dica PWA -->
<div class="native-card">
    <div style="font-size: 18px; font-weight: 700; color: #ffffff;">Sobre o ManyControl</div>
    <div style="font-size: 13px; color: var(--text-gray-400); line-height: 1.6;">
        <p>• <strong>Privacidade:</strong> Seus dados ficam salvos de forma privada no seu dispositivo.</p>
        <p>• <strong>iPhone / Safari:</strong> Toque no ícone de <strong>Compartilhar</strong> e escolha <strong>"Adicionar à Tela de Início"</strong> para usar em tela cheia.</p>
    </div>
</div>

<!-- Card 4: Zona de Perigo -->
<div class="native-card" style="border-color: #991b1b;">
    <div style="font-size: 16px; font-weight: 700; color: #f87171;">Zona de Perigo</div>
    <div style="font-size: 12px; color: var(--text-gray-400);">
        Apaga todos os dados e retorna o app ao estado inicial de fábrica.
    </div>
    <button class="btn-native-red" style="margin-top: 6px;" @onclick="ConfirmarLimpezaDadosAsync">
        Resetar Todos os Dados
    </button>
</div>

@code {
    private List<Categoria> Categorias = [];
    private string NovaCategoriaNome = string.Empty;
    private string NovaCategoriaTipo = "Despesa";
    private string MensagemBackup = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategoriasAsync();
    }

    private async Task CarregarCategoriasAsync()
    {
        Categorias = await FinanceService.GetCategoriasAsync();
        StateHasChanged();
    }

    private async Task AdicionarCategoriaAsync()
    {
        if (string.IsNullOrWhiteSpace(NovaCategoriaNome)) return;

        await FinanceService.AddCategoriaAsync(NovaCategoriaNome, NovaCategoriaTipo);
        NovaCategoriaNome = string.Empty;
        await CarregarCategoriasAsync();
    }

    private async Task ExcluirCategoriaAsync(Guid id)
    {
        await FinanceService.DeleteCategoriaAsync(id);
        await CarregarCategoriasAsync();
    }

    private async Task ExportarBackup()
    {
        await BackupService.ExportarBackupAsync();
        MensagemBackup = "Arquivo de backup exportado com sucesso!";
    }

    private async Task TriggerImportFile()
    {
        await JSRuntime.InvokeVoidAsync("manyControlJs.triggerFileInput", "backupFileInput");
    }

    private async Task ProcessarArquivoImportado(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();

            var sucesso = await BackupService.ImportarBackupJsonAsync(json, sobrescrever: false);
            if (sucesso)
            {
                MensagemBackup = "Dados importados e sincronizados com sucesso!";
                await CarregarCategoriasAsync();
            }
            else
            {
                MensagemBackup = "Formato de arquivo inválido.";
            }
        }
        catch (Exception ex)
        {
            MensagemBackup = $"Erro ao importar: {ex.Message}";
        }
    }

    private async Task ConfirmarLimpezaDadosAsync()
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja apagar todos os dados financeiros deste dispositivo? Esta ação não pode ser desfeita.");
        if (confirm)
        {
            await FinanceService.LimparTodosDadosAsync();
            await CarregarCategoriasAsync();
            MensagemBackup = "Todos os dados foram resetados com sucesso.";
        }
    }
}
