@inherits LayoutComponentBase

<div class="app-layout">
    <header class="main-content" style="padding-bottom: 0;">
        <div class="native-header">
            <img src="icon-192.png" alt="ManyControl" class="native-header-logo" />
            <div style="display: flex; flex-direction: column;">
                <div class="native-header-title">ManyControl</div>
                <div class="native-header-sub">Gestão Financeira e Sincronização em Nuvem</div>
            </div>
        </div>
    </header>

    <main class="main-content" style="padding-top: 0;">
        @Body
    </main>

    <ManyControl_Web.Components.BottomNav />
</div>
